# Supabase Edge Function (ตั้งใน Supabase Dashboard > Edge Functions > Secrets)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_BUCKET=line-message-media

# NAS Sync Script (ตั้งใน Synology Task Scheduler > Environment Variables)
# Volume: volume2
# Script path: /volume2/Raw_line_chat/scripts/nas-sync.js
BASE_LOG_DIR=/volume2/Raw_line_chat/raw_logs
BASE_MEDIA_DIR=/volume2/Raw_line_chat/media
MEDIA_DELETE_GRACE_DAYS=2
MEDIA_CLEANUP_LIMIT=100
CONFIRM_REMOTE_MEDIA_DELETE=false

# Local analyzer (Windows)
RAW_LOG_DIR=Y:\raw_logs
REPORT_DIR=Y:\reports
DEFAULT_LOOKBACK_DAYS=30
PRODUCTION_LOOKBACK_DAYS=90
TIMEZONE=Asia/Bangkok
