# Supabase Edge Function (ตั้งใน Supabase Dashboard > Edge Functions > Secrets)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# NAS Sync Script (ตั้งใน Synology Task Scheduler > Environment Variables)
# Volume: volume2
# Script path: /volume2/Raw_line_chat/nas-sync.js
BASE_LOG_DIR=/volume2/Raw_line_chat/raw_logs

# Local analyzer (Windows)
DEFAULT_LOOKBACK_DAYS=30
PRODUCTION_LOOKBACK_DAYS=90
TIMEZONE=Asia/Bangkok
